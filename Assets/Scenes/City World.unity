  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 49d2dd5fdd698324a8b1a8767ceb7788, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  nodeN1: {fileID: 517809075}
  nodeN2: {fileID: 2040059302}
  nodeN3: {fileID: 49152750}
  nodeN4: {fileID: 157014323}
  nodeN5: {fileID: 777851374}
  nodeN6: {fileID: 0}
  narratorSource: {fileID: 0}
  subtitleText: {fileID: 1824517221}
  n1Lines:
  - subtitle: "T\u1EDBi l\xFAc ph\u1EA3i v\u1EC1 nh\xE0 r\u1ED3i. Qu\u1EA3 l\xE0
      m\u1ED9t ng\xE0y d\xE0i nh\u1EC9."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "M\u1ECDi th\u1EE9 nh\u01B0 m\u1ED9t gi\u1EA5c m\u01A1 nh\u1EC9."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Nh\u01B0ng ph\xEDa tr\u01B0\u1EDBc b\u1EA1n c\xF2n m\u1ED9t th\u1EED
      th\xE1ch n\u1EEFa \u0111\u1EC3 v\u01B0\u1EE3t qua."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 887757803}
    deactivateAfter: 0
  - subtitle: "B\u1EA1n nghe th\u1EA5y ch\xFAng ch\u1EE9."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Ti\u1EBFng nh\u1EEFng ng\xE3 t\u01B0 kh\xF4ng c\xF3 h\u1ED3i k\u1EBFt."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "M\xECnh bi\u1EBFt b\u1EA1n s\u1EE3 nh\u01B0ng kh\xF4ng sao c\u1EA3
      c\xF3 m\xECnh \u1EDF \u0111\xE2y"
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Khi ti\u1EBFng c\xF2i d\u1ECBu l\u1EA1i 1 n\u01A1i, \u0111\xF3 l\xE0
      l\xFAc b\u1EA1n \u0111i."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Khi ti\u1EBFng c\xF2i \u1ED3 \u1EA1t \u0111i qua th\xEC b\u1EA1n n\xEAn
      \u0111\u1EE9ng l\u1EA1i.\n"
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "H\xE3y c\u1EA9n th\u1EADn ch\xFA \xFD l\u1EAFng nghe nh\xE9."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  n2Lines: []
  n3Lines: []
  n4Lines: []
  n5Lines: []
  n6Lines: []
