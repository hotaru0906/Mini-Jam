    fallbackDuration: 1.2
  n2Lines:
  - subtitle: "T\u1ED1t l\u1EAFm"
    voiceClip: {fileID: 8300000, guid: 78851ce9c74796541b70b96fb0ee74ec, type: 3}
    pauseAfter: 0.35
    fallbackDuration: 0.7
  - subtitle: "B\u1EA1n \u0111ang \u1EDF m\u1ED9t n\u01A1i \u0111\u1EB7c bi\u1EC7t"
    voiceClip: {fileID: 8300000, guid: 1ac6b7908a82f4e4f9430e9d42c9f2bb, type: 3}
    pauseAfter: 0.7
    fallbackDuration: 1.2
  - subtitle: "N\u01A1i \u0111\xE2y l\u01B0u gi\u1EEF nh\u1EEFng \xE2m thanh t\u1EEB
      nhi\u1EC1u n\u01A1i kh\xE1c nhau."
    voiceClip: {fileID: 8300000, guid: 5f629bdc0363e3f4cae360377e52bfda, type: 3}
    pauseAfter: 0.7
    fallbackDuration: 1.4
  - subtitle: "M\u1ED7i \xE2m thanh \u0111\u1EC1u d\u1EABn \u0111\u1EBFn m\u1ED9t
      tr\u1EA3i nghi\u1EC7m ri\xEAng."
    voiceClip: {fileID: 8300000, guid: 3c514d163edcd754da40d2a2e66fda38, type: 3}
    pauseAfter: 0.7
    fallbackDuration: 1.3
  - subtitle: "H\xE3y ti\u1EBFn th\xEAm m\u1ED9t ch\xFAt n\u1EEFa \u0111\u1EC3 l\u1EAFng
      nghe r\xF5 h\u01A1n nh\xE9!"
    voiceClip: {fileID: 8300000, guid: ced6991b984e0454c93a707897f0feb4, type: 3}
    pauseAfter: 0.4
    fallbackDuration: 1.1
  n3Lines:
  - subtitle: "Tr\u01B0\u1EDBc m\u1EB7t b\u1EA1n l\xE0 ba ti\u1EBFng v\u1ECDng."
    voiceClip: {fileID: 8300000, guid: 13e3e2939052e6c4c9d9ea53b8ce853e, type: 3}
    pauseAfter: 0.7
    fallbackDuration: 1.2
  - subtitle: "M\u1ED7i n\u01A1i mang theo nh\u1EEFng \xE2m thanh v\xE0 c\xE2u chuy\u1EC7n
      kh\xE1c nhau."
    voiceClip: {fileID: 8300000, guid: 550d951203ead2f4b955c32a1004cb97, type: 3}
    pauseAfter: 0.7
    fallbackDuration: 1.5
  - subtitle: "H\xE3y l\u1EAFng nghe."
    voiceClip: {fileID: 8300000, guid: 0db51486e49baa249ad7e90e28c8865d, type: 3}
    pauseAfter: 0.1
    fallbackDuration: 0.2
  - subtitle: "V\xE0 ch\u1ECDn n\u01A1i b\u1EA1n mu\u1ED1n c\u1EA3m nh\u1EADn nh\u1EA5t."
    voiceClip: {fileID: 8300000, guid: 4eba4c5052d75764da08c5aac8ba3a86, type: 3}
    pauseAfter: 0.1
    fallbackDuration: 1.3
