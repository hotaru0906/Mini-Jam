  m_GameObject: {fileID: 349217342}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 49d2dd5fdd698324a8b1a8767ceb7788, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  nodeN1: {fileID: 517809075}
  nodeN2: {fileID: 2040059302}
  nodeN3: {fileID: 49152750}
  nodeN4: {fileID: 157014323}
  nodeN5: {fileID: 777851374}
  nodeN6: {fileID: 1347161988}
  narratorSource: {fileID: 0}
  subtitleText: {fileID: 1824517221}
  n1Lines:
  - subtitle: "Ch\xFAng ta \u0111\xE3 t\u1EDBi n\u01A1i."
    voiceClip: {fileID: 8300000, guid: 82263bd81c5f256429279d648c1dd733, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "B\u1EA1n c\xF3 nghe th\u1EA5y ti\u1EBFng g\xEC kh\xF4ng?"
    voiceClip: {fileID: 8300000, guid: e7fa931167155a648a4a6cc4e2ead710, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "\u1ED2 b\u1EA1n kh\xF4ng nghe th\u1EA5y \xE0?"
    voiceClip: {fileID: 8300000, guid: ce691348b34050e479612d1fcc86a414, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "\u0110\xE2u b\u1EA1n th\u1EED l\u1EAFng nghe k\u0129 l\u1EA1i xem"
    voiceClip: {fileID: 8300000, guid: 29e77481ac6841c4fb240cc6ffd5f1bf, type: 3}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 558351828}
    - {fileID: 2040059301}
    - {fileID: 49152749}
    deactivateAfter: 0
  - subtitle: "Ti\u1EBFng gi\xF3 \u0111ang l\u01B0\u1EDBt qua nh\u1EEFng t\xE1n l\xE1."
    voiceClip: {fileID: 8300000, guid: 6ee82ed9e065944499b950424ac7351f, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "V\xE0 nh\u1EEFng ch\xFA chim \u0111ang c\u1EA5t ti\u1EBFng h\xE1t
      \u1EDF \u0111\xE2u \u0111\xF3"
    voiceClip: {fileID: 8300000, guid: 5b692f4166ce0d445bc4d8dc55c9a504, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "N\u1EBFu \u0111\u1EC3 \xFD k\u0129 l\u1EA1i h\xECnh nh\u01B0 m\xECnh
      nghe th\u1EA5y ti\u1EBFng su\u1ED1i \u1EDF \u0111\xE2u \u0111\xF3"
    voiceClip: {fileID: 8300000, guid: fa613961c6728d348974166de3814dbf, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "V\xE0 h\xECnh nh\u01B0 c\u0169ng c\xF3 ti\u1EBFng ve s\u1EA7u n\u1EEFa"
    voiceClip: {fileID: 8300000, guid: 80538bd367d02514492cadb166ade864, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Trong hai n\u01A1i n\xE0y, b\u1EA1n mu\u1ED1n \u0111i kh\xE1m ph\xE1
      \u1EDF n\u01A1i n\xE0o nh\u1EC9?"
    voiceClip: {fileID: 8300000, guid: 7b1bc5ea1dbe94c47ab92f3c80ee1772, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  n2Lines:
  - subtitle: "Ch\xFAng ta \u0111\xE3 t\u1EDBi n\u01A1i m\xE0 b\u1EA1n mu\u1ED1n
      kh\xE1m ph\xE1 r\u1ED3i \u0111\xF3"
    voiceClip: {fileID: 8300000, guid: 417c527090b3c474bb6a76745573f90a, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "M\u1ED9t d\xF2ng su\u1ED1i. Nghe th\u1EADt d\u1EC5 ch\u1ECBu nh\u1EC9."
    voiceClip: {fileID: 8300000, guid: 2ce3def3311d3e34caa50cd24c62552a, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Ch\u1EC9 \u0111\u1EE9ng c\u1EA1nh d\xF2ng su\u1ED1i th\xF4i, m\xE0
      l\xF2ng m\xECnh c\u1EA3m th\u1EA5y b\xECnh y\xEAn h\u1EB3n."
    voiceClip: {fileID: 8300000, guid: b096182dbe5721747829249c3dc5bd16, type: 3}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "B\u1EA1n bi\u1EBFt kh\xF4ng... C\xF3 m\u1ED9t \u0111i\u1EC1u m\xE0
      m\xECnh lu\xF4n lu\xF4n t\xF2 m\xF2 t\u1EDBi."
    voiceClip: {fileID: 8300000, guid: c93baa46f5da8f74987b601102102fac, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Nh\u1EEFng d\xF2ng su\u1ED1i nh\u01B0 th\u1EBF n\xE0y, n\xF3 b\u1EAFt
      \u0111\u1EA7u t\u1EEB \u0111\xE2u nh\u1EC9?"
    voiceClip: {fileID: 8300000, guid: 2347e0eef4fef08448e9b9ad761fd9dc, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "T\u1EEB m\u1ED9t ng\u1ECDn n\xFAi xa? Hay t\u1EEB nh\u1EEFng c\u01A1n
      m\u01B0a \u0111\xE3 r\u01A1i xu\u1ED1ng t\u1EEB r\u1EA5t l\xE2u r\u1ED3i?"
    voiceClip: {fileID: 8300000, guid: 42958dfbd54f2214fa1215c22153c730, type: 3}
    pauseAfter: 2
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "C\xF3 th\u1EE9 g\xEC \u0111\xF3 v\u1EEBa nh\u1EA3y l\xEAn th\xEC ph\u1EA3i."
    voiceClip: {fileID: 8300000, guid: a3ff815e4aee4b44780d8aec13804eb6, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 1036362076}
    deactivateAfter: 0
  - subtitle: "C\xF3 v\u1EBB l\xE0 1 con c\xE1, h\xECnh nh\u01B0 n\xF3 c\u0169ng
      t\xF2 m\xF2 xem ai \u0111ang ng\u1EAFm n\xF3 \u0111\u1EA5y"
    voiceClip: {fileID: 8300000, guid: ed342d138d5ad3f4787a676ab9fbcb84, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "D\xF9 sao th\xEC n\u01A1i c\xF3 n\u01B0\u1EDBc lu\xF4n thu h\xFAt
      nhi\u1EC1u s\u1EF1 s\u1ED1ng"
    voiceClip: {fileID: 8300000, guid: 888d4f76575f0d145b109555044a4422, type: 3}
    pauseAfter: 1
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "C\xF3 ti\u1EBFng g\xEC \u0111\xF3 ph\xE1t ra g\u1EA7n \u0111\xE2y"
    voiceClip: {fileID: 8300000, guid: a827260566d93754eab790035b926b9d, type: 3}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 1140007753}
    deactivateAfter: 0
  - subtitle: "B\u1EA1n c\xF3 mu\u1ED1n \u0111i theo h\u01B0\u1EDBng ph\xE1t ra \xE2m
      thanh n\xE0y kh\xF4ng?"
    voiceClip: {fileID: 8300000, guid: 74cc25246ab765c4d967cde9277faf1d, type: 3}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Ho\u1EB7c l\xE0 ch\xFAng ta c\xF3 th\u1EC3 tr\xE1nh n\xF3 b\u1EB1ng
      vi\u1EC7c \u0111i h\u01B0\u1EDBng ng\u01B0\u1EE3c l\u1EA1i."
    voiceClip: {fileID: 8300000, guid: 7259af67d38b0c54588f66767a9bdcb5, type: 3}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 157014322}
    - {fileID: 777851373}
    deactivateAfter: 0
  n3Lines:
  - subtitle: "C\xF3 v\u1EBB ch\xFAng ta v\u1EEBa t\xECm th\u1EA5y nh\u1EEFng nh\u1EA1c
      s\u0129 c\u1EE7a khu r\u1EEBng n\xE0y."
    voiceClip: {fileID: 8300000, guid: c3f1f423c9777b043a507a87aa209965, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "V\xE0o nh\u1EEFng ng\xE0y n\u1EAFng \u1EA5m, ch\xFAng c\xF3 th\u1EC3
      h\xE1t t\u1EEB s\xE1ng \u0111\u1EBFn chi\u1EC1u m\xE0 ch\u1EB3ng kh\xF4ng th\u1EA5y
      m\u1EC7t."
    voiceClip: {fileID: 8300000, guid: d7766882354f28844a897bcd5caab44c, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "N\u1EBFu l\xE0 m\xECnh th\xEC ch\u1EAFc m\xECnh \u0111\xE3 ng\u1EE7
      t\u1EEB l\xE2u r\u1ED3i."
    voiceClip: {fileID: 8300000, guid: 1452dc77fb81c8346b3897c2c0406ccb, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "C\xF3 v\u1EBB b\u1EA1n \u0111ang t\u1EADn h\u01B0\u1EDFng bu\u1ED5i
      h\xF2a nh\u1EA1c n\xE0y r\u1ED3i nh\u1EC9."
    voiceClip: {fileID: 8300000, guid: 3ae9cc6a03b044c4c93e091e03259c4a, type: 3}
    pauseAfter: 1
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "M\xECnh c\u0169ng v\u1EADy. C\xF3 nh\u1EEFng \xE2m thanh m\xE0 khi\u1EBFn
      ng\u01B0\u1EDDi ta ch\u1EC9 mu\u1ED1n \u0111\u1EE9ng l\u1EA1i v\xE0 l\u1EAFng
      nghe th\xEAm m\u1ED9t x\xEDu n\u1EEFa th\xF4i."
    voiceClip: {fileID: 8300000, guid: cdb76f50f8ce43149b3cb9141ab5dbac, type: 3}
    pauseAfter: 1
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "C\xF3 ti\u1EBFng g\xEC \u0111\xF3 ph\xE1t ra g\u1EA7n \u0111\xE2y"
    voiceClip: {fileID: 8300000, guid: a827260566d93754eab790035b926b9d, type: 3}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 171928467}
    deactivateAfter: 0
  - subtitle: "B\u1EA1n c\xF3 mu\u1ED1n \u0111i theo h\u01B0\u1EDBng ph\xE1t ra \xE2m
      thanh n\xE0y kh\xF4ng?"
    voiceClip: {fileID: 8300000, guid: 74cc25246ab765c4d967cde9277faf1d, type: 3}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Ho\u1EB7c l\xE0 ch\xFAng ta c\xF3 th\u1EC3 tr\xE1nh n\xF3 b\u1EB1ng
      vi\u1EC7c \u0111i h\u01B0\u1EDBng ng\u01B0\u1EE3c l\u1EA1i."
    voiceClip: {fileID: 8300000, guid: 7259af67d38b0c54588f66767a9bdcb5, type: 3}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 157014322}
    - {fileID: 777851373}
    deactivateAfter: 0
  n4Lines:
  - subtitle: "Ch\xFAng ta \u0111\xE3 t\u1EDBi n\u01A1i ph\xE1t ra \xE2m thanh \u0111\xF3
      r\u1ED3i."
    voiceClip: {fileID: 8300000, guid: da7877e48f4605e4a9acddbfcada5194, type: 3}
    pauseAfter: 1.2
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "\xC0 h\xF3a ra l\xE0 1 con th\u1ECF, nh\xECn n\xF3 nh\u1ECF h\u01A1n
      m\xECnh t\u01B0\u1EDFng"
    voiceClip: {fileID: 8300000, guid: 68d1b0b085d0d7c42b629fc3ec31d64f, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 1515500276}
    deactivateAfter: 0
  - subtitle: "Tr\xF4ng n\xF3 d\u1EC5 th\u01B0\u01A1ng l\u1EAFm"
    voiceClip: {fileID: 8300000, guid: 0dc99d2afee6b5a43b7c31d9c8380c43, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "B\u1ED9 l\xF4ng c\u1EE7a n\xF3 m\u1EC1m nh\u01B0 nh\u1EEFng chi\u1EBFc
      l\xE1 kh\xF4 v\u1EEBa r\u01A1i xu\u1ED1ng \u0111\u1EA5t v\u1EADy."
    voiceClip: {fileID: 8300000, guid: bc92f0f021996494c8028f23f746ae47, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "\u0110\xF4i tai th\xEC d\xE0i v\xE0 ch\xFAng v\u1EABn \u0111ang li\xEAn
      t\u1EE5c c\u1EED \u0111\u1ED9ng."
    voiceClip: {fileID: 8300000, guid: ebc789d8f2efd3c419f9f2ad089c665b, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "B\u1EA1n mu\u1ED1n th\u1EED ch\u1EA1m v\xE0o n\xF3 kh\xF4ng?"
    voiceClip: {fileID: 8300000, guid: 95ea7f4df2dfd0949af19013595a2bed, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "C\u1EA9n th\u1EADn! B\u1EA1n c\xF3 sao kh\xF4ng?"
    voiceClip: {fileID: 8300000, guid: 51942105e28698944b87da7b82eb2e4c, type: 3}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 1962697889}
    deactivateAfter: 0
  - subtitle: "H\xEAn qu\xE1 b\u1EA1n kh\xF4ng sao."
    voiceClip: {fileID: 8300000, guid: c18ddbf7b2bb1f142923c2a4b0cb406a, type: 3}
    pauseAfter: 1.2
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "H\u1ED3i n\xE3y l\xE0 ti\u1EBFng g\xEC \xE0. C\xE0nh c\xE2y v\u1EEBa
      r\u01A1i xu\u1ED1ng g\u1EA7n b\u1EA1n \u0111\xF3."
    voiceClip: {fileID: 8300000, guid: c1f0bf03144d7f3449d98d90522b03c9, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Nh\u01B0ng m\xE0 b\u1EA1n kh\xF4ng sao l\xE0 t\u1ED1t r\u1ED3i c\xF3
      \u0111i\u1EC1u con th\u1ECF gi\u1EADt m\xECnh v\xE0 b\u1ECF \u0111i m\u1EA5t
      ti\xEAu r\u1ED3i"
    voiceClip: {fileID: 8300000, guid: 9526129c0d2e97d42aa6070d1562346c, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "M\xECnh ngh\u0129 h\xE0nh tr\xECnh kh\xE1m ph\xE1 khu r\u1EEBng t\u1EDBi
      \u0111\xE2y th\xF4i."
    voiceClip: {fileID: 8300000, guid: 4c6aecc734793b647879c0cdeb333982, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "N\xE0o c\xF9ng m\xECnh ti\u1EBFn l\xEAn ph\xEDa tr\u01B0\u1EDBc nh\xE9"
    voiceClip: {fileID: 8300000, guid: 1679b12d9b2c0314dacc4ac98bcae6c2, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  n5Lines:
  - subtitle: "T\u1EE5i m\xECnh \u0111\xE3 r\u1EDDi kh\xE1 xa ch\u1ED7 h\u1ED3i n\xE3y
      r\u1ED3i."
    voiceClip: {fileID: 8300000, guid: 1d0d5f5dcbe859f42b12b48b87a5bcff, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "M\xE0 m\xECnh th\u1EA5y khu r\u1EEBng n\xE0y r\u1ED9ng h\u01A1n m\xECnh
      ngh\u0129 \u0111\xF3"
    voiceClip: {fileID: 8300000, guid: 9248933c1b521cd45a10f8870333668a, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "C\xE0ng \u0111i m\xECnh c\xE0ng th\u1EA5y nhi\u1EC1u c\xE2y h\u01A1n."
    voiceClip: {fileID: 8300000, guid: 4379834e0a508d2418ac8f31a62c9355, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "H\xECnh nh\u01B0 c\xE1i g\xEC \u0111\xF3 chuy\u1EC3n \u0111\u1ED9ng
      trong b\u1EE5i c\xE2y."
    voiceClip: {fileID: 8300000, guid: 7f35c3426a58c044da4d82bddfc15e7f, type: 3}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 1734948804}
    deactivateAfter: 0
  - subtitle: "\xD4i b\u1EA1n c\xF3 sao kh\xF4ng, m\xECnh th\u1EA5y con th\u1ECF
      n\xF3 v\u1EEBa nh\u1EA3y v\xE0o l\xF2ng b\u1EA1n."
    voiceClip: {fileID: 8300000, guid: 324029e07c7270049a8b2127dadc9c18, type: 3}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 1515500276}
    deactivateAfter: 0
  - subtitle: "C\xF3 v\u1EBB nh\u01B0 nh\xF3c h\u01A1i ho\u1EA3ng lo\u1EA1n v\xEC
      \u0111\xE2m tr\xFAng b\u1EA1n."
    voiceClip: {fileID: 8300000, guid: 29a4fbae318f46d429aca973eaefa444, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "\u1ED2 b\u1EA1n \u0111ang vu\u1ED1t l\xF4ng khi\u1EBFn cho n\xF3 b\xECnh
      t\u0129nh l\u1EA1i \xE0."
    voiceClip: {fileID: 8300000, guid: c22297d11f821874ababd480b390325d, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "L\xF4ng c\u1EE7a n\xF3 m\u1EC1m l\u1EAFm \u0111\xFAng kh\xF4ng."
    voiceClip: {fileID: 8300000, guid: 41be85de87128234ab7366facd9080a1, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "C\u1EA9n th\u1EADn! B\u1EA1n \u1ED5n ch\u1EE9?"
    voiceClip: {fileID: 8300000, guid: 51942105e28698944b87da7b82eb2e4c, type: 3}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 1962697889}
    deactivateAfter: 0
  - subtitle: "May qu\xE1 b\u1EA1n kh\xF4ng sao."
    voiceClip: {fileID: 8300000, guid: c18ddbf7b2bb1f142923c2a4b0cb406a, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "H\u1ED3i n\xE3y l\xE0 ti\u1EBFng g\xEC \xE0. C\xE0nh c\xE2y v\u1EEBa
      r\u01A1i xu\u1ED1ng g\u1EA7n b\u1EA1n \u0111\xF3."
    voiceClip: {fileID: 8300000, guid: c1f0bf03144d7f3449d98d90522b03c9, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Nh\u01B0ng m\xE0 b\u1EA1n kh\xF4ng sao l\xE0 t\u1ED1t r\u1ED3i m\u1EB7c
      d\xF9 con th\u1ECF th\u1EA5y gi\u1EADt m\xECnh v\xE0 b\u1ECF \u0111i m\u1EA5t
      r\u1ED3i"
    voiceClip: {fileID: 8300000, guid: 9526129c0d2e97d42aa6070d1562346c, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "M\xECnh ngh\u0129 h\xE0nh tr\xECnh kh\xE1m ph\xE1 khu r\u1EEBng t\u1EDBi
      \u0111\xE2y th\xF4i."
    voiceClip: {fileID: 8300000, guid: 4c6aecc734793b647879c0cdeb333982, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "N\xE0o c\xF9ng m\xECnh ti\u1EBFn l\xEAn ph\xEDa tr\u01B0\u1EDBc nh\xE9"
    voiceClip: {fileID: 8300000, guid: 1679b12d9b2c0314dacc4ac98bcae6c2, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  n6Lines:
  - subtitle: "May l\xE0 h\u1ED3i n\xE3y b\u1EA1n kh\xF4ng sao."
    voiceClip: {fileID: 8300000, guid: 963150b915d67cb409271e488f69e856, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Nh\u01B0ng c\u0169ng kh\xF4ng th\u1EC3 tr\xE1ch c\xE1i c\xE2y \u0111\xF3
      \u0111\u01B0\u1EE3c."
    voiceClip: {fileID: 8300000, guid: 3e776f62bfd88464bba14dc07c8a57a8, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "N\xF3 \u0111\xE3 s\u1ED1ng \u1EDF \u0111\xE2y r\u1EA5t l\xE2u r\u1ED3i."
    voiceClip: {fileID: 8300000, guid: 12dc2350c590f1c4c9cfcb8951b61292, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Gi\u1ED1ng nh\u01B0 m\u1ECDi sinh v\u1EADt trong khu r\u1EEBng. C\xE2y
      c\u1ED1i c\u0169ng gi\xE0 \u0111i theo th\u1EDDi gian."
    voiceClip: {fileID: 8300000, guid: 415a89a0c1ad47747ad9299a22adae5c, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "\u0110\xF4i khi m\u1ED9t c\xE0nh c\xE2y r\u01A1i xu\u1ED1ng."
    voiceClip: {fileID: 8300000, guid: be49b08b58c8227438d106f945244e16, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Ho\u1EB7c l\xE0 m\u1ED9t th\xE2n c\xE2y \u0111\u1ED5 ng\xE3."
    voiceClip: {fileID: 8300000, guid: f3e85e2f4ed147f47a86970bf53a97b4, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Nghe c\xF3 v\u1EBB \u0111\xE1ng ti\u1EBFc."
    voiceClip: {fileID: 8300000, guid: 015be001fef77f84c953232f1c1de6d4, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Nh\u01B0ng ch\xEDnh th\xE2n c\xE2y gi\xE0 \u1EA5y n\xF3 l\xE0 n\u01A1i
      c\u01B0 tr\xFA cho c\xF4n tr\xF9ng, n\u1EA5m v\xE0 nhi\u1EC1u sinh v\u1EADt
      kh\xE1c."
    voiceClip: {fileID: 8300000, guid: 24578cac787dec54595e7e44d0da482f, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Trong khu r\u1EEBng n\xE0y, m\u1ECDi th\u1EE9 \u0111\u1EC1u k\u1EBFt
      n\u1ED1i v\u1EDBi nhau."
    voiceClip: {fileID: 8300000, guid: 7e42cfa3daa8cb147a146702d9d0fe1a, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Qu\u1EA3 l\xE0 m\u1ED9t chuy\u1EBFn \u0111i th\xFA v\u1ECB \u0111\xFAng
      kh\xF4ng."
    voiceClip: {fileID: 8300000, guid: 89a00336b9b9ec94f97f35afa9d2f454, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Nh\u01B0ng th\u1EBF gi\u1EDBi ngo\xE0i k\xECa c\xF2n r\u1ED9ng l\u1EDBn
      h\u01A1n khu r\u1EEBng n\xE0y."
    voiceClip: {fileID: 8300000, guid: a3b804dbca5ef9e4a9dcdbca7e73ca0a, type: 3}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "B\u1EA1n h\xE3y l\u1EAFng nghe."
    voiceClip: {fileID: 8300000, guid: c3bbf6999c522ff49aa420110233275f, type: 3}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 548162667}
    deactivateAfter: 0
  - subtitle: "N\u01A1i nh\u1EEFng con s\xF3ng v\u1EABn kh\xF4ng ng\u1EEBng v\u1ED7
      v\xE0o b\u1EDD. N\xE0o c\xF9ng m\xECnh \u0111i kh\xE1m ph\xE1 nh\xE9"
    voiceClip: {fileID: 8300000, guid: 8b459934f1052324f811c54dca87d6d9, type: 3}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  lockRegionSelectionUntilN6: 1
  regionSelectionObjects: []
  n1StartDelay: 1.5
