  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 49d2dd5fdd698324a8b1a8767ceb7788, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  nodeN1: {fileID: 517809075}
  nodeN2: {fileID: 2040059302}
  nodeN3: {fileID: 49152750}
  nodeN4: {fileID: 157014323}
  nodeN5: {fileID: 777851374}
  nodeN6: {fileID: 1347161988}
  narratorSource: {fileID: 0}
  subtitleText: {fileID: 1824517221}
  n1Lines:
  - subtitle: "Ch\xFAng ta \u0111\xE3 t\u1EDBi n\u01A1i."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "B\u1EA1n c\xF3 nghe th\u1EA5y ti\u1EBFng g\xEC kh\xF4ng?"
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "\u1ED2 b\u1EA1n kh\xF4ng nghe th\u1EA5y \xE0?"
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "\u0110\xE2u b\u1EA1n th\u1EED l\u1EAFng nghe k\u0129 h\u01A1n xem"
    voiceClip: {fileID: 0}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 558351828}
    - {fileID: 2040059301}
    - {fileID: 49152749}
    deactivateAfter: 0
  - subtitle: "Ti\u1EBFng gi\xF3 \u0111ang l\u01B0\u1EDBt qua nh\u1EEFng t\xE1n l\xE1."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "V\xE0 nh\u1EEFng ch\xFA chim \u0111ang c\u1EA5t ti\u1EBFng h\xE1t
      \u1EDF \u0111\xE2u \u0111\xF3"
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "\xD4 n\u1EBFu \u0111\u1EC3 \xFD k\u0129 l\u1EA1i h\xECnh nh\u01B0
      m\xECnh nghe th\u1EA5y ti\u1EBFng su\u1ED1i"
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "V\xE0 m\u1ED9t b\xEAn c\xF3 v\u1EBB ti\u1EBFng ve s\u1EA7u"
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "B\u1EA1n mu\u1ED1n kh\xE1m ph\xE1 s\xE2u h\u01A1n \u1EDF n\u01A1i
      n\xE0o nh\u1EA5t?"
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  n2Lines:
  - subtitle: "Cu\u1ED1i c\xF9ng ch\xFAng ta c\u0169ng t\u1EDBi \u0111\u01B0\u1EE3c
      ngu\u1ED3n \xE2m thanh n\xE0y r\u1ED3i."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "M\u1ED9t d\xF2ng su\u1ED1i. Nghe th\u1EADt d\u1EC5 ch\u1ECBu nh\u1EC9."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Ch\u1EC9 c\u1EA7n \u0111\u1EE9ng c\u1EA1nh d\xF2ng n\u01B0\u1EDBc
      th\xF4i, m\xECnh \u0111\xE3 th\u1EA5y trong l\xF2ng b\xECnh y\xEAn h\u01A1n
      h\u1EB3n"
    voiceClip: {fileID: 0}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "B\u1EA1n bi\u1EBFt kh\xF4ng... C\xF3 m\u1ED9t \u0111i\u1EC1u m\xECnh
      v\u1EABn lu\xF4n t\xF2 m\xF2."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Nh\u1EEFng d\xF2ng su\u1ED1i nh\u01B0 th\u1EBF n\xE0y b\u1EAFt \u0111\u1EA7u
      t\u1EEB \u0111\xE2u nh\u1EC9?"
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "T\u1EEB m\u1ED9t ng\u1ECDn n\xFAi xa x\xF4i? Hay t\u1EEB nh\u1EEFng
      c\u01A1n m\u01B0a \u0111\xE3 r\u01A1i xu\u1ED1ng t\u1EEB r\u1EA5t l\xE2u r\u1ED3i?"
    voiceClip: {fileID: 0}
    pauseAfter: 2
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "C\xF3 th\u1EE9 g\xEC \u0111\xF3 v\u1EEBa nh\u1EA3y l\xEAn kh\u1ECFi
      m\u1EB7t n\u01B0\u1EDBc."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 1036362076}
    deactivateAfter: 0
  - subtitle: "C\xF3 v\u1EBB l\xE0 1 con c\xE1, h\xECnh nh\u01B0 n\xF3 c\u0169ng
      t\xF2 m\xF2 xem ai \u0111ang ng\u1EAFm n\xF3 \u0111\u1EA5y"
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "D\xF9 sao th\xEC n\u01A1i c\xF3 n\u01B0\u1EDBc lu\xF4n thu h\xFAt
      nhi\u1EC1u s\u1EF1 s\u1ED1ng"
    voiceClip: {fileID: 0}
    pauseAfter: 1
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "C\xF3 ti\u1EBFng g\xEC \u0111\xF3 ph\xE1t ra g\u1EA7n \u0111\xE2y"
    voiceClip: {fileID: 0}
    pauseAfter: 1
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "B\u1EA1n c\xF3 mu\u1ED1n \u0111i theo h\u01B0\u1EDBng ph\xE1t ra \xE2m
      thanh kh\xF4ng?"
    voiceClip: {fileID: 0}
    pauseAfter: 1
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Ch\xFAng ta c\u0169ng c\xF3 th\u1EC3 tr\xE1nh \u0111i b\u1EB1ng vi\u1EC7c
      \u0111i ng\u01B0\u1EE3c h\u01B0\u1EDBng ph\xE1t ra. Quy\u1EC1n quy\u1EBFt \u0111\u1ECBnh
      l\xE0 n\u1EB1m \u1EDF b\u1EA1n"
    voiceClip: {fileID: 0}
    pauseAfter: 1
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 157014322}
    - {fileID: 777851373}
    deactivateAfter: 0
  n3Lines:
  - subtitle: "C\xF3 v\u1EBB ch\xFAng ta v\u1EEBa t\xECm th\u1EA5y nh\u1EEFng nh\u1EA1c
      c\xF4ng ch\u0103m ch\u1EC9 nh\u1EA5t c\u1EE7a khu r\u1EEBng."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "V\xE0o nh\u1EEFng ng\xE0y n\u1EAFng \u1EA5m, ch\xFAng c\xF3 th\u1EC3
      h\xE1t t\u1EEB s\xE1ng \u0111\u1EBFn chi\u1EC1u m\xE0 ch\u1EB3ng h\u1EC1 bi\u1EBFt
      m\u1EC7t."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "N\u1EBFu l\xE0 m\xECnh th\xEC ch\u1EAFc m\xECnh \u0111\xE3 ngh\u1EC9
      t\u1EEB l\xE2u r\u1ED3i."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "C\xF3 v\u1EBB b\u1EA1n \u0111ang kh\xE1 t\u1EADn h\u01B0\u1EDFng bu\u1ED5i
      h\xF2a nh\u1EA1c n\xE0y r\u1ED3i nh\u1EC9."
    voiceClip: {fileID: 0}
    pauseAfter: 1
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "M\xECnh c\u0169ng v\u1EADy c\xF3 nh\u1EEFng \xE2m thanh khi\u1EBFn
      ng\u01B0\u1EDDi ta ch\u1EC9 mu\u1ED1n \u0111\u1EE9ng l\u1EA1i v\xE0 l\u1EAFng
      nghe th\xEAm m\u1ED9t ch\xFAt."
    voiceClip: {fileID: 0}
    pauseAfter: 1
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "M\xECnh c\u0169ng v\u1EADy c\xF3 nh\u1EEFng \xE2m thanh khi\u1EBFn
      ng\u01B0\u1EDDi ta ch\u1EC9 mu\u1ED1n \u0111\u1EE9ng l\u1EA1i v\xE0 l\u1EAFng
      nghe th\xEAm m\u1ED9t ch\xFAt."
    voiceClip: {fileID: 0}
    pauseAfter: 3
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "C\xF3 ti\u1EBFng g\xEC \u0111\xF3 ph\xE1t ra g\u1EA7n \u0111\xE2y"
    voiceClip: {fileID: 0}
    pauseAfter: 1
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "B\u1EA1n c\xF3 mu\u1ED1n \u0111i theo h\u01B0\u1EDBng ph\xE1t ra \xE2m
      thanh kh\xF4ng?"
    voiceClip: {fileID: 0}
    pauseAfter: 1
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Ch\xFAng ta c\u0169ng c\xF3 th\u1EC3 tr\xE1nh \u0111i b\u1EB1ng vi\u1EC7c
      \u0111i ng\u01B0\u1EE3c h\u01B0\u1EDBng ph\xE1t ra. Quy\u1EC1n quy\u1EBFt \u0111\u1ECBnh
      l\xE0 n\u1EB1m \u1EDF b\u1EA1n"
    voiceClip: {fileID: 0}
    pauseAfter: 1
    fallbackDuration: 1.2
    objectsToActivate:
    - {fileID: 157014322}
    - {fileID: 777851373}
    deactivateAfter: 0
  n4Lines:
  - subtitle: "Ch\xFAng ta \u0111\xE3 t\u1EDBi n\u01A1i ph\xE1t ra \xE2m thanh \u0111\xF3
      r\u1ED3i."
    voiceClip: {fileID: 0}
    pauseAfter: 1.2
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "\xC0 h\xF3a ra l\xE0 1 con th\u1ECF, nh\xECn n\xF3 nh\u1ECF h\u01A1n
      m\xECnh t\u01B0\u1EDFng"
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Tr\xF4ng n\xF3 d\u1EC5 th\u01B0\u01A1ng l\u1EAFm"
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "B\u1ED9 l\xF4ng c\u1EE7a n\xF3 m\u1EC1m nh\u01B0 nh\u1EEFng chi\u1EBFc
      l\xE1 kh\xF4 v\u1EEBa r\u01A1i xu\u1ED1ng \u0111\u1EA5t v\u1EADy."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "\u0110\xF4i tai th\xEC d\xE0i v\xE0 ch\xFAng v\u1EABn \u0111ang li\xEAn
      t\u1EE5c c\u1EED \u0111\u1ED9ng."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "B\u1EA1n mu\u1ED1n th\u1EED ch\u1EA1m v\xE0o n\xF3 kh\xF4ng?"
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "C\u1EA9n th\u1EADn! B\u1EA1n \u1ED5n ch\u1EE9?"
    voiceClip: {fileID: 0}
    pauseAfter: 1.2
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "C\u1EA9n th\u1EADn! B\u1EA1n \u1ED5n ch\u1EE9?"
    voiceClip: {fileID: 0}
    pauseAfter: 1.2
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "May qu\xE1 b\u1EA1n kh\xF4ng sao."
    voiceClip: {fileID: 0}
    pauseAfter: 1.2
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "H\u1ED3i n\xE3y l\xE0 ti\u1EBFng g\xEC \xE0. C\xE0nh c\xE2y v\u1EEBa
      r\u01A1i xu\u1ED1ng g\u1EA7n b\u1EA1n \u0111\xF3."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "Nh\u01B0ng m\xE0 b\u1EA1n kh\xF4ng sao l\xE0 t\u1ED1t r\u1ED3i m\u1EB7c
      d\xF9 con th\u1ECF th\u1EA5y gi\u1EADt m\xECnh v\xE0 b\u1ECF \u0111i m\u1EA5t
      r\u1ED3i"
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "M\xECnh ngh\u0129 h\xE0nh tr\xECnh kh\xE1m ph\xE1 khu r\u1EEBng t\u1EDBi
      \u0111\xE2y th\xF4i."
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  - subtitle: "N\xE0o c\xF9ng m\xECnh ti\u1EBFn l\xEAn ph\xEDa tr\u01B0\u1EDBc nh\xE9"
    voiceClip: {fileID: 0}
    pauseAfter: 0.6
    fallbackDuration: 1.2
    objectsToActivate: []
    deactivateAfter: 0
  n5Lines:
  - subtitle: 
    voiceClip: {fileID: 0}
    pauseAfter: 0
    fallbackDuration: 0
    objectsToActivate: []
    deactivateAfter: 0
